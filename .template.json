{
  "features": {
    "blog": {
      "paths": [
        "src/collections/Posts.ts",
        "src/features/lexicalCode/",
        "src/ui/blog/",
        "src/app/blog/",
        "src/app/actions/blog.ts",
        "src/app/feed.xml/",
        "src/core/blog.ts",
        "src/ui/lib/jsonLd.tsx"
      ],
      "markers": ["blog"],
      "deps": ["@lexical/code", "lexical", "shiki"],
      "envVars": []
    },
    "i18n": {
      "paths": ["src/i18n/", "src/messages/", "src/proxy.ts"],
      "markers": ["i18n"],
      "inverseMarkers": ["no-i18n"],
      "deps": ["next-intl"],
      "envVars": [],
      "relocate": {
        "description": "Move root pages under [locale]/ when kept",
        "moves": [
          { "from": "src/app/layout.tsx", "to": "src/app/[locale]/layout.tsx" },
          { "from": "src/app/page.tsx", "to": "src/app/[locale]/page.tsx" },
          { "from": "src/app/blog/", "to": "src/app/[locale]/blog/" }
        ]
      }
    },
    "contact": {
      "paths": ["src/app/actions/contact.ts", "src/ui/contact/"],
      "markers": ["contact"],
      "deps": ["resend", "@hookform/resolvers", "react-hook-form"],
      "envVars": ["RESEND_API_KEY", "CONTACT_EMAIL_TO", "CONTACT_EMAIL_FROM"]
    },
    "seed": {
      "paths": ["src/seed/"],
      "markers": ["seed"],
      "deps": [],
      "envVars": []
    },
    "ga": {
      "paths": [],
      "markers": ["ga"],
      "deps": [],
      "envVars": ["NEXT_PUBLIC_GA_MEASUREMENT_ID"]
    }
  },
  "defaults": {
    "blog": true,
    "i18n": false,
    "contact": false,
    "seed": true,
    "ga": false
  }
}
